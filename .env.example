# Copy to .env and fill in. Never commit .env.

# --- Negotiation agent: Anthropic Messages API ---
ANTHROPIC_API_KEY=
# Any model available to your key; check with: uv run python -m app.llm.anthropic
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Leave empty for models that don't support effort.
ANTHROPIC_EFFORT=low
# "default" enables server-side refusal fallbacks; leave empty to disable.
ANTHROPIC_REFUSAL_FALLBACK=default

# --- Telephony: Twilio Voice (only needed for real calls) ---
# Account SID is available in the Twilio Console. Put the Auth Token from
# Account -> API keys & tokens here; never commit .env or paste it into chat.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VOICE_NUMBER=
# Configure this number: Console -> Phone Numbers -> your number -> "A call comes in"
# POST to $WEBHOOK_BASE_URL/webhooks/voice/$VOICE_WEBHOOK_SECRET.
# Trial accounts can only call verified Caller IDs and prepend a trial announcement.

# --- Telephony: Africa's Talking Voice (retired; retained temporarily) ---
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=
# Google TTS voice for <Say>, e.g. en-US-Standard-C; empty uses Africa's Talking's default.
AT_TTS_VOICE=
AT_RECORD_MAX_SECONDS=15
AT_RECORD_SILENCE_TIMEOUT_SECONDS=3
# Hosts allowed to serve recordingUrl downloads (comma-separated; subdomains included).
AT_RECORDING_HOSTS=africastalking.com,at-internal.com

# --- Speech-to-text: Google Cloud Speech-to-Text v2 (only needed for real calls) ---
# Service-account JSON key, stored OUTSIDE the repo. Empty = Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
# chirp_3 runs in the "us" and "eu" multi-regions.
GOOGLE_STT_LOCATION=eu
GOOGLE_STT_MODEL=chirp_3
# en-KE isn't supported by v2; compare en-GB / en-US / en-IN on real recordings (#5).
GOOGLE_STT_LANGUAGE_CODES=en-GB
GOOGLE_STT_TIMEOUT_SECONDS=8
# Comma-separated phrases to boost, e.g. shillings,KES. Empty disables adaptation.
GOOGLE_STT_PHRASE_HINTS=
# Long random string; the callback URL is $WEBHOOK_BASE_URL/webhooks/voice/$VOICE_WEBHOOK_SECRET
VOICE_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
APP_URL=http://localhost:8000

DATABASE_URL=sqlite:///./transaction_agent.db
TIMEZONE=Africa/Nairobi

PROVIDER_1_NAME=
PROVIDER_1_PHONE=
PROVIDER_2_NAME=
PROVIDER_2_PHONE=
PROVIDER_LOCATION=Nairobi

MAX_CALLS_PER_DAY=40
CALL_HARD_END_SECONDS=180
CONFIRM_RETRY_DELAY_SECONDS=120
