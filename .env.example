# Copy to .env and fill in. Never commit .env.

# --- Negotiation agent: Anthropic Messages API ---
ANTHROPIC_API_KEY=
# Any model available to your key; check with: uv run python -m app.llm.anthropic
ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max. Leave empty for models that don't support effort.
ANTHROPIC_EFFORT=low
# "default" enables server-side refusal fallbacks; leave empty to disable.
ANTHROPIC_REFUSAL_FALLBACK=default

# --- Telephony: Africa's Talking Voice (only needed for real calls) ---
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=
# Long random string; the callback URL is $WEBHOOK_BASE_URL/webhooks/voice/$VOICE_WEBHOOK_SECRET
VOICE_WEBHOOK_SECRET=
WEBHOOK_BASE_URL=
APP_URL=http://localhost:8000

DATABASE_URL=sqlite:///./transaction_agent.db
TIMEZONE=Africa/Nairobi

PROVIDER_1_NAME=
PROVIDER_1_PHONE=
PROVIDER_2_NAME=
PROVIDER_2_PHONE=
PROVIDER_LOCATION=Nairobi

MAX_CALLS_PER_DAY=40
CALL_HARD_END_SECONDS=180
CONFIRM_RETRY_DELAY_SECONDS=120
