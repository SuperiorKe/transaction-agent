{
  "name": "transaction-agent-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "gen:api": "openapi-typescript openapi.json -o src/api/openapi.gen.ts",
    "predev": "npm run gen:api",
    "dev": "vite",
    "prebuild": "npm run gen:api",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run gen:api",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
